{
  "meta": {
    "title": "TwinRed",
    "description": "RTB rules for TwinRed SSP OpenRTB integration",
    "version": "1.0.0",
    "modified_at": "2026-06-20T00:00:00Z",
    "docs": [
      {
        "title": "TwinRed SSP OpenRTB Integration",
        "link": "https://control.twinred.com/docs/integration/sspopenrtb"
      }
    ]
  },
  "formats": [
    "direct",
    "proxy",
    "video",
    "proxy_300x250",
    "proxy_300x100",
    "proxy_728x90",
    "banner_300x250",
    "banner_300x100",
    "banner_728x90"
  ],
  "interstitial_formats": ["proxy"],
  "rules": [
    {
      "condition": {
        "formats": [
          "proxy_300x250",
          "proxy_300x100",
          "proxy_728x90",
          "banner_300x250",
          "banner_300x100",
          "banner_728x90"
        ],
        "interstitial": "exclude",
        "push": "exclude"
      },
      "config": { "ext": { "format": 1 } }
    },
    {
      "condition": {
        "formats": ["proxy"],
        "interstitial": "include",
        "push": "exclude"
      },
      "config": { "ext": { "format": 5 } }
    },
    {
      "condition": {
        "formats": ["direct"],
        "interstitial": "exclude",
        "push": "exclude"
      },
      "config": { "ext": { "format": 4 } }
    }
  ]
}
